ggplot(head(df_shap, 20), aes(x = reorder(Variable, SHAP_Importance), y = SHAP_Importance)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(title = "Importancia SHAP (Top 20)", x = "Variable", y = "SHAP promedio") +
theme_minimal()
# Seleccionar las N variables más importantes (por ejemplo, top 20)
top_vars <- head(df_shap[order(-df_shap$SHAP_Importance), "Variable"], 15)
# Crear un nuevo X solo con esas variables
X_shap <- data[, top_vars]
# Asegurarse de que es numérico
X_shap <- X_shap[, sapply(X_shap, is.numeric)]
X_shap <- as.data.frame(X_shap)
# Variable respuesta (ya transformada si hiciste lo de PS → EE)
Y <- as.factor(data$`Mejor_resp`)
# Control de validación cruzada Leave-One-Out
ctrl_loo <- trainControl(
method = "LOOCV",
classProbs = TRUE,
savePredictions = "final"
)
# Entrenamiento con las variables SHAP seleccionadas
set.seed(123)
modelo_rf_shap <- train(
x = X_shap,
y = Y,
method = "rf",
trControl = ctrl_loo,
importance = TRUE
)
# Mostrar resumen
print(modelo_rf_shap)
confusionMatrix(modelo_rf_shap$pred$pred, modelo_rf_shap$pred$obs)
library(caret)
set.seed(123)
# Y debe ser un factor ordenado
y <- factor(data$`Mejor_resp`, levels = c("RC", "RP", "EE", "PE"), ordered = TRUE)
# Usa tus variables SHAP ordenadas por importancia
shap_vars <- df_shap[order(-df_shap$SHAP_Importance), "Variable"]
# Inicializar resultados
resultados_rf <- data.frame(Iteracion = integer(), Accuracy = numeric(), Variables = character())
# Configuración LOO
ctrl_loo <- trainControl(
method = "LOOCV",
classProbs = FALSE,
savePredictions = "final"
)
for (iter in 1:100) {
# 1. Selección aleatoria de 15 variables de las top SHAP
vars_aleatorias <- sample(shap_vars, size = 15)
X_reducido <- data[, vars_aleatorias, drop = FALSE]
X_reducido <- X_reducido[, sapply(X_reducido, is.numeric)]
# 2. Entrenar modelo RF con LOO
modelo_rf <- train(
x = X_reducido,
y = y,
method = "rf",
trControl = ctrl_loo,
importance = TRUE
)
# 3. Evaluación
acc <- confusionMatrix(modelo_rf$pred$pred, modelo_rf$pred$obs)$overall["Accuracy"]
# 4. Guardar resultados
resultados_rf <- rbind(resultados_rf, data.frame(
Iteracion = iter,
Accuracy = as.numeric(acc),
Variables = paste(vars_aleatorias, collapse = ", ")
))
cat("Iteración", iter, "- Accuracy:", round(acc, 3), "\n")
}
# Ver las 5 mejores combinaciones
resultados_rf_top <- resultados_rf[order(-resultados_rf$Accuracy), ]
print(head(resultados_rf_top, 5))
