library(ggplot2)
library(ggVennDiagram)
# Cargar solo los nombres de columnas
pls_mejor <- names(read.xlsx("variablesPLS-DA-X1eval.xlsx"))
ord_mejor <- names(read.xlsx("variables-ordinalNET-X1eval.xlsx"))
rf_mejor  <- names(read.xlsx("variables-RF-X1eval.xlsx"))
xgb_mejor <- names(read.xlsx("variables-Xgboost-X1eval.xlsx"))
# Normalizar (sin espacios, minúsculas)
v_pls <- tolower(trimws(pls_mejor))
v_ord <- tolower(trimws(ord_mejor))[1:30]  # Solo las 30 primeras
v_rf  <- tolower(trimws(rf_mejor))
v_xgb <- tolower(trimws(xgb_mejor))
# Lista de conjuntos
venn_datos <- list(
`PLS-DA` = v_pls,
`OrdinalNet` = v_ord,
`Random Forest` = v_rf,
`XGBoost` = v_xgb
)
# Paleta personalizada en gradiente (convertida a continuo)
