library(openxlsx)
library(ggplot2)
library(ggVennDiagram)
# Cargar solo los nombres de columnas
pls_mejor <- names(read.xlsx("variablesPLS-DA-mejorResp.xlsx"))
ord_mejor <- names(read.xlsx("variables-ordinalNET-mejorResp.xlsx"))
rf_mejor  <- names(read.xlsx("variables-RF-mejorResp.xlsx"))
xgb_mejor <- names(read.xlsx("variables-Xgboost-mejorResp.xlsx"))
# Normalizar (sin espacios, minúsculas)
v_pls <- tolower(trimws(pls_mejor))
v_ord <- tolower(trimws(ord_mejor))[1:30]  # Solo las 30 primeras
v_rf  <- tolower(trimws(rf_mejor))
v_xgb <- tolower(trimws(xgb_mejor))
# Lista de conjuntos
venn_datos <- list(
`PLS-DA` = v_pls,
`OrdinalNet` = v_ord,
`Random Forest` = v_rf,
`XGBoost` = v_xgb
)
# Paleta personalizada (hasta 5 tonos)
colores_custom <- c("#F96B04", "#EF9F01", "#E4B815", "#80B295", "#37B0B4")
# Gráfico Venn
ggVennDiagram(venn_datos,
label = "count",
label_alpha = 0) +
scale_fill_manual(values = colores_custom) +
theme_void() +
theme(
legend.position = "none",
text = element_text(family = "serif", size = 12)
)
