library(ggplot2)
# Cargar solo los nombres de columnas
pls_mejor <- names(read.xlsx("variablesPLS-DA-mejorResp.xlsx"))
#ord_mejor <- names(read.xlsx("variables-ordinalNET-mejorResp.xlsx"))
rf_mejor  <- names(read.xlsx("variables-RF-mejorResp.xlsx"))
xgb_mejor <- names(read.xlsx("variables-Xgboost-mejorResp.xlsx"))
# Limpiar: quitar espacios y pasar a minúscula para comparar bien
v_pls <- tolower(trimws(pls_mejor))
v_ord <- tolower(trimws(ord_mejor))
v_rf  <- tolower(trimws(rf_mejor))
v_xgb <- tolower(trimws(xgb_mejor))
# Intersección de las 4 listas
vars_comunes <- Reduce(intersect, list(v_pls, v_rf, v_xgb))
# Resultado
length(vars_comunes)  # Te debería dar 11
print(vars_comunes)
venn_datos <- list(
`PLS-DA` = v_pls,
`OrdinalNet` = v_ord,
`Random Forest` = v_rf,
`XGBoost` = v_xgb
)
library(ggplot2)      # Cargar explícitamente ggplot2
library(ggVennDiagram)
# Crear lista de conjuntos
venn_datos <- list(
`PLS-DA` = v_pls,
`OrdinalNet` = v_ord,
`Random Forest` = v_rf,
`XGBoost` = v_xgb
)
# Gráfico mejorado
ggVennDiagram(venn_datos,
label = "count",
label_alpha = 0,
category.names = c("PLS-DA", "Random Forest", "XGBoost")) +
scale_fill_gradient(low = "#f2f2f2", high = "#80B295") +
theme_void() +
theme(
legend.position = "none",
text = element_text(family = "serif", size = 12)
)
print(vars_comunes)  # lista las que usan los 4 modelos
