ord_mejor <- names(read.xlsx("variables-ordinalNET-mejorResp.xlsx"))
rf_mejor  <- names(read.xlsx("variables-RF-mejorResp.xlsx"))
xgb_mejor <- names(read.xlsx("variables-Xgboost-mejorResp.xlsx"))
# Normalizar (sin espacios, minúsculas)
v_pls <- tolower(trimws(pls_mejor))
v_ord <- tolower(trimws(ord_mejor))[1:30]  # Solo las 30 primeras
v_rf  <- tolower(trimws(rf_mejor))
v_xgb <- tolower(trimws(xgb_mejor))
# Lista de conjuntos
venn_datos <- list(
`PLS-DA` = v_pls,
`OrdinalNet` = v_ord,
`Random Forest` = v_rf,
