# Reemplazo de columnas combinadas y eliminación de duplicados
datos <- datos %>%
mutate(
estudios   = coalesce(Estudios...14, Estudios...29),
est_civil  = coalesce(Est_civil...15, Est_civil...31),
hogar      = coalesce(Comp_hogar...16, Comp_hogar...32),
MOOSs      = coalesce(MOSs...17, MOSs...33),
ansiedad   = coalesce(Ansiedad...18, Ansiedad...36),
depresion  = coalesce(Depresion...19, Depresion...37),
MNA        = coalesce(MNA...20, MNA...27)
) %>%
select(
-Estudios...14, -Estudios...29,
-Est_civil...15, -Est_civil...31,
-Comp_hogar...16, -Comp_hogar...32,
-MOSs...17, -MOSs...33,
-Ansiedad...18, -Ansiedad...36,
-Depresion...19, -Depresion...37,
-MNA...20, -MNA...27
)
names(datos)
# Fusionar columnas duplicadas usando coalesce
datos <- datos %>%
mutate(
Estudios   = coalesce(Estudios, Estudios.1),
Est_civil  = coalesce(Est_civil, Est_civil.1),
Comp_hogar = coalesce(Comp_hogar, Comp_hogar.1),
MOSs       = coalesce(MOSs, MOSs.1),
Ansiedad   = coalesce(Ansiedad, Ansiedad.1),
Depresion  = coalesce(Depresion, Depresion.1),
MNA        = coalesce(MNA, MNA.1)
) %>%
select(
-Estudios.1, -Est_civil.1, -Comp_hogar.1,
-MOSs.1, -Ansiedad.1, -Depresion.1, -MNA.1
)
